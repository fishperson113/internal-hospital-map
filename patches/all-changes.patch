-
-    val baseRadius = if (isSelected) 22f else 16f
-
-    // Marker drop shadow
-    drawCircle(
-        color = Color(0x33000000),
-        radius = baseRadius + 4f,
-        center = Offset(center.x, center.y + 3f)
-    )
-
-    // Outer white halo
