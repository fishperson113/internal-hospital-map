-private fun DrawScope.drawMapBase(layerType: MapLayerType) {
-    val bgColor = when (layerType) {
-        MapLayerType.STANDARD -> Color(0xFFF3F4F6)
-        MapLayerType.SATELLITE -> Color(0xFF1B242C)
-        MapLayerType.TRAFFIC -> Color(0xFFEFEFEF)
-    }
